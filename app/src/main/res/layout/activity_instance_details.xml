<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInstanceHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonBackFromInstanceDetails"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@android:string/cancel"
                    android:minWidth="44dp"
                    android:minHeight="44dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_arrow_back_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <ImageView
                    android:id="@+id/imageInstanceIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_instance_icon"
                    android:contentDescription="@string/create_instance_select_icon"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textInstanceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textInstanceMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPlay"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/button_play_instance" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPlayServer"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/button_play_server" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonInstanceSettings"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/instance_settings_content_description"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_settings_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="12dp"
        android:text="@string/instance_details_content_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layoutContentActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:animateLayoutChanges="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBrowseContent"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/button_browse_content"
                app:icon="@drawable/ic_browse_content_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAddMods"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:ellipsize="end"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/button_upload_mods" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCheckContentUpdates"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:ellipsize="end"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/instance_content_check_updates"
                app:icon="@drawable/ic_sync_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonContentFilter"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:ellipsize="end"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/instance_content_filter_all_short"
                app:icon="@drawable/ic_filter_list_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonUpdateAllContent"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/instance_content_update_all"
                android:visibility="gone"
                app:icon="@drawable/ic_update_24" />
        </LinearLayout>
    </LinearLayout>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutContentSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/textContentSelectionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSelectAllContent"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="44dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        android:text="@string/instance_content_select_all"
                        app:icon="@drawable/ic_check_24" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonUpdateSelectedContent"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="44dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        android:text="@string/instance_content_update_selected"
                        app:icon="@drawable/ic_update_24" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonEnableSelectedContent"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minWidth="0dp"
                        android:minHeight="44dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        android:text="@string/instance_content_enable_selected"
                        android:visibility="gone"
                        app:icon="@drawable/ic_enable_24" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDisableSelectedContent"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minWidth="0dp"
                        android:minHeight="44dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        android:text="@string/instance_content_disable_selected"
                        android:visibility="gone"
                        app:icon="@drawable/ic_disable_24" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDeleteSelectedContent"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minWidth="0dp"
                        android:minHeight="44dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        android:text="@string/instance_content_delete_selected"
                        app:icon="@drawable/ic_delete_24"
                        app:iconTint="?attr/colorError"
                        app:strokeColor="?attr/colorError" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonClearContentSelection"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minWidth="0dp"
                        android:minHeight="44dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/instance_content_clear_selection" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/textModsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutContentSearch"
        style="@style/Widget.Material3.TextInputLayout.FilledBox"
        android:background="@drawable/bg_content_browser_search"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        app:boxCornerRadiusBottomEnd="18dp"
        app:boxCornerRadiusBottomStart="18dp"
        app:boxCornerRadiusTopEnd="18dp"
        app:boxCornerRadiusTopStart="18dp"
        app:boxBackgroundColor="?attr/colorSurfaceVariant"
            app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:endIconMode="clear_text"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_search_24"
        app:startIconTint="?attr/colorPrimary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextContentSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="Search content"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="text"
            android:maxLines="1"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <ca.dnamobile.droidbridgelauncher.ui.view.RoundedClipFrameLayout
        android:id="@+id/layoutResourceCategoryTabs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_content_tab_container"
        android:clipChildren="true"
        android:clipToPadding="true">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabResourceCategories"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:padding="4dp"
            app:tabGravity="start"
            app:tabIndicator="@drawable/bg_content_tab_indicator"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorHeight="44dp"
            app:tabMinWidth="0dp"
            app:tabMode="scrollable"
            app:tabPaddingEnd="16dp"
            app:tabPaddingStart="16dp"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="?attr/colorOnPrimaryContainer"
            app:tabTextAppearance="@style/TextAppearance.Material3.TitleSmall"
            app:tabTextColor="?attr/colorOnSurfaceVariant" />
    </ca.dnamobile.droidbridgelauncher.ui.view.RoundedClipFrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardResourceItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:strokeWidth="0dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerResourceItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="ifContentScrolls"
            android:paddingStart="2dp"
            android:paddingTop="6dp"
            android:paddingEnd="2dp"
            android:paddingBottom="2dp" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutContentPager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_content_browser_controls_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonContentPagePrevious"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="@string/instance_content_page_previous"
            app:icon="@drawable/ic_chevron_left_24" />

        <TextView
            android:id="@+id/textContentPageStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonContentPageNext"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:text="@string/instance_content_page_next"
            app:icon="@drawable/ic_chevron_right_24"
            app:iconGravity="textEnd" />
    </LinearLayout>
</LinearLayout>
