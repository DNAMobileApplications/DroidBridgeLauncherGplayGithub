<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollContentBrowserRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:descendantFocusability="beforeDescendants"
    android:fillViewport="false"
    android:focusableInTouchMode="true"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="18dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardContentBrowserHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/layoutContentBrowserHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBackToInstance"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_width="46dp"
                android:layout_height="44dp"
                android:contentDescription="@string/content_browser_back_to_instance"
                android:minWidth="46dp"
                android:minHeight="44dp"
                android:padding="0dp"
                app:icon="@drawable/ic_arrow_back_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <ImageView
                android:id="@+id/imageContentBrowserInstanceIcon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_content_browser_instance_icon"
                android:contentDescription="@string/content_browser_instance_icon_description"
                android:padding="4dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textContentBrowserInstanceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textContentBrowserInstanceMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonContentBrowserVersionLock"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="Change Minecraft version filter"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_lock_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleContentSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSourceModrinth"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/content_browser_source_modrinth" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSourceCurseForge"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/content_browser_source_curseforge" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/layoutContentTabsSearchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:id="@+id/layoutContentTypeTabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_content_browser_tabs_container"
                    android:clipToOutline="true"
                    android:padding="4dp">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabContentTypes"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@android:color/transparent"
                        app:tabGravity="start"
                        app:tabIndicator="@drawable/bg_content_browser_tab_indicator"
                        app:tabIndicatorFullWidth="true"
                        app:tabIndicatorHeight="44dp"
                        app:tabMinWidth="0dp"
                        app:tabMode="scrollable"
                        app:tabPaddingEnd="18dp"
                        app:tabPaddingStart="18dp"
                        app:tabRippleColor="@android:color/transparent"
                        app:tabSelectedTextColor="?attr/colorOnPrimaryContainer"
                        app:tabTextAppearance="@style/TextAppearance.Material3.TitleSmall"
                        app:tabTextColor="?attr/colorOnSurfaceVariant" />
                </FrameLayout>
            </HorizontalScrollView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutContentSearch"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_content_browser_search"
                app:boxBackgroundMode="none"
                app:endIconMode="clear_text"
                app:endIconTint="?attr/colorOnSurfaceVariant"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search_24"
                app:startIconTint="?attr/colorOnSurfaceVariant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editContentSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutModpackBrowseModeTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleModpackBrowseMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonModpackAll"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:minHeight="44dp"
                    android:text="@string/content_browser_modpack_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonModpackFavourites"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:minHeight="44dp"
                    android:text="@string/content_browser_modpack_favourites"
                    app:icon="@drawable/ic_favorite_24" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_content_browser_controls_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/textContentBrowserTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/content_browser_install_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold" 
                android:textColor="?attr/colorOnSurface"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSortContent"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/content_browser_sort_downloads"
                app:icon="@drawable/ic_expand_more_24"
                app:iconGravity="textEnd" 
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorSurface"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:strokeColor="?attr/colorOutline"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/layoutContentPaginationTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPagePreviousTop"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_width="46dp"
                    android:layout_height="42dp"
                    android:contentDescription="@string/content_browser_previous_page"
                    android:focusable="false"
                    android:minWidth="46dp"
                    android:minHeight="42dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_chevron_left_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" 
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorSurface"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:strokeColor="?attr/colorOutline"/>

                <TextView
                    android:id="@+id/textPageIndicatorTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold" 
                android:textColor="?attr/colorOnSurface"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPageNextTop"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_width="46dp"
                    android:layout_height="42dp"
                    android:contentDescription="@string/content_browser_next_page"
                    android:focusable="false"
                    android:minWidth="46dp"
                    android:minHeight="42dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_chevron_right_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" 
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorSurface"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:strokeColor="?attr/colorOutline"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textContentBrowserResultSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/layoutContentFilterChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textContentBrowserVersionChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_content_browser_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

                <TextView
                    android:id="@+id/textContentBrowserLoaderChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_content_browser_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />
            </LinearLayout>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerContentProjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:focusable="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutContentPaginationBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_content_browser_controls_panel"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPagePreviousBottom"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:contentDescription="@string/content_browser_previous_page"
                android:focusable="false"
                android:minWidth="48dp"
                android:minHeight="44dp"
                android:padding="0dp"
                app:icon="@drawable/ic_chevron_left_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp" 
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorSurface"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:strokeColor="?attr/colorOutline"/>

            <TextView
                android:id="@+id/textPageIndicatorBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold" 
                android:textColor="?attr/colorOnSurface"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPageNextBottom"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:contentDescription="@string/content_browser_next_page"
                android:focusable="false"
                android:minWidth="48dp"
                android:minHeight="44dp"
                android:padding="0dp"
                app:icon="@drawable/ic_chevron_right_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp" 
                android:textColor="?attr/colorOnSurface"
                app:backgroundTint="?attr/colorSurface"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:strokeColor="?attr/colorOutline"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
